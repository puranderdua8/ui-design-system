{
  "name": "@puranderdua/ui",
  "version": "0.8.0",
  "description": "Token-driven design system for React 19 and Tailwind v4: typography, actions, layout, forms and overlay scoping (ThemeScope), with themeable tokens.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "design-tokens",
    "tailwindcss",
    "react",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puranderdua8/ui-design-system.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./foundations.css": "./dist/foundations.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./themes/*.json": "./dist/themes/*.json",
    "./contrast-pairs.json": "./dist/contrast-pairs.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "node ../../scripts/build-ui.mjs",
    "playground:dev": "pnpm build && vite playground",
    "playground:check": "pnpm build && vite build playground && node playground/verify-css.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:layout": "playwright test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "vite": "^8.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-direction": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "tailwind-merge": "^3.7.0"
  }
}
