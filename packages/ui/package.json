{
  "name": "@puranderdua/ui",
  "version": "0.4.0",
  "description": "Token-driven design system: Text, Heading, Button, Link and layout components, with themeable tokens.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "design-tokens",
    "tailwindcss",
    "react",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puranderdua8/ui-design-system.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./foundations.css": "./dist/foundations.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./themes/*.json": "./dist/themes/*.json",
    "./contrast-pairs.json": "./dist/contrast-pairs.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node ../../scripts/build-classes.mjs && tsup && node ../../scripts/build-foundations.mjs",
    "playground:dev": "pnpm build && vite playground",
    "playground:check": "pnpm build && vite build playground && node playground/verify-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:layout": "playwright test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "vite": "^8.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  }
}
