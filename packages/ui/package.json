{
  "name": "@puranderdua/ui",
  "version": "0.0.0",
  "description": "Token-driven design system: Text, Heading and Button.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
