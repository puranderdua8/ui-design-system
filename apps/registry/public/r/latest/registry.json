{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "puranderdua",
  "homepage": "https://puranderdua-registry.vercel.app",
  "items": [
    {
      "name": "ds-foundations",
      "type": "registry:file",
      "title": "Design system foundations",
      "description": "Tokens, Tailwind v4 bridge and type/focus recipes (foundations.css).",
      "docs": "Import it once in your globals.css, after Tailwind: @import \"tailwindcss\"; @import \"../styles/ds-foundations.css\"; (adjust the relative path to where globals.css sits; with a src/ directory it lands in src/styles/).",
      "files": [
        {
          "path": "packages/ui/dist/foundations.css",
          "type": "registry:file",
          "target": "styles/ds-foundations.css"
        }
      ]
    },
    {
      "name": "ds-types",
      "type": "registry:lib",
      "title": "Design system ref types",
      "description": "StrictRef and ElementProps helper types used by the components.",
      "files": [
        {
          "path": "packages/ui/src/lib/types.ts",
          "type": "registry:lib",
          "target": "lib/types.ts"
        }
      ]
    },
    {
      "name": "ds-utils",
      "type": "registry:lib",
      "title": "Design system cn()",
      "description": "cn() with tailwind-merge extended for ds-* type sizes and recipes (replaces shadcn's lib/utils.ts).",
      "docs": "This replaces lib/utils.ts with a cn() that understands the ds-* classes. The CLI asks before overwriting an existing file.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "packages/ui/src/lib/utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        },
        {
          "path": "packages/ui/src/lib/generated/ds-classes.ts",
          "type": "registry:lib",
          "target": "lib/generated/ds-classes.ts"
        }
      ]
    },
    {
      "name": "ds-typography",
      "type": "registry:ui",
      "title": "Text and Heading",
      "description": "Token-driven Text and Heading components.",
      "dependencies": ["class-variance-authority"],
      "registryDependencies": [
        "https://puranderdua-registry.vercel.app/r/v0.1.0/ds-utils.json",
        "https://puranderdua-registry.vercel.app/r/v0.1.0/ds-types.json",
        "https://puranderdua-registry.vercel.app/r/v0.1.0/ds-foundations.json"
      ],
      "files": [
        {
          "path": "packages/ui/src/components/text.tsx",
          "type": "registry:ui",
          "target": "components/ui/text.tsx"
        },
        {
          "path": "packages/ui/src/components/heading.tsx",
          "type": "registry:ui",
          "target": "components/ui/heading.tsx"
        }
      ]
    },
    {
      "name": "ds-button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Token-driven Button (primary and secondary; sm and md).",
      "dependencies": ["class-variance-authority", "@radix-ui/react-slot"],
      "registryDependencies": [
        "https://puranderdua-registry.vercel.app/r/v0.1.0/ds-utils.json",
        "https://puranderdua-registry.vercel.app/r/v0.1.0/ds-types.json",
        "https://puranderdua-registry.vercel.app/r/v0.1.0/ds-foundations.json"
      ],
      "files": [
        {
          "path": "packages/ui/src/components/button.tsx",
          "type": "registry:ui",
          "target": "components/ui/button.tsx"
        }
      ]
    }
  ]
}
