{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "pnpm --filter @puranderdua/ui build && storybook dev -p 6006",
    "build-storybook": "pnpm --filter @puranderdua/ui build && storybook build -o storybook-static",
    "test:stories": "pnpm --filter @puranderdua/ui build && vitest run",
    "typecheck": "pnpm --filter @puranderdua/ui build && tsc --noEmit"
  },
  "dependencies": {
    "@puranderdua/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.65.0",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  }
}
