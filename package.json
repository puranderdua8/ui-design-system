{
  "name": "ui-design-system",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "check": "pnpm lint && pnpm tokens:check && pnpm typecheck && pnpm test && pnpm build && pnpm --filter @puranderdua/ui playground:check && pnpm --filter docs build-storybook"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "style-dictionary": "^4.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
