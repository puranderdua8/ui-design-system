{
  "shadow": {
    "$type": "shadow",
    "$description": "Raw shadow recipes. Components use the semantic elevation.* tokens. Diffuse: large blur, warm tint.",
    "sm": {
      "$value": {
        "color": "#0d0b0514",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "0px"
      }
    },
    "lg": {
      "$value": {
        "color": "#0d0b0524",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "40px",
        "spread": "0px"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "$description": "Raw transition lengths. Gentle.",
    "100": { "$value": "200ms" },
    "200": { "$value": "350ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "Raw timing curves. Slow in, slow out.",
    "in-out": { "$value": [0.45, 0.05, 0.35, 1] },
    "out-strong": { "$value": [0.25, 0.1, 0.1, 1] }
  }
}
