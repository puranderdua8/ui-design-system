{
  "space": {
    "$type": "dimension",
    "$description": "Key is the multiple of 0.25rem; 1-5 means 1.5. Relaxed: the steps from 3 up are 12 to 25% roomier than Base.",
    "1": { "$value": "0.25rem" },
    "1-5": { "$value": "0.375rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.875rem" },
    "4": { "$value": "1.125rem" },
    "6": { "$value": "1.75rem" },
    "8": { "$value": "2.25rem" },
    "12": { "$value": "3.5rem" },
    "16": { "$value": "4.5rem" },
    "24": { "$value": "7rem" }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "sm": { "$value": "2.25rem" },
      "md": { "$value": "2.75rem" }
    },
    "target": {
      "min": {
        "$value": "1.5rem",
        "$description": "Smallest pointer target (WCAG 2.2 SC 2.5.8, 24 CSS px). A denser theme may not go below this."
      }
    },
    "container": {
      "sm": { "$value": "40rem" },
      "md": { "$value": "48rem" },
      "lg": { "$value": "64rem" },
      "xl": { "$value": "80rem" }
    },
    "item": {
      "sm": { "$value": "12rem" },
      "md": { "$value": "16rem" },
      "lg": { "$value": "20rem" }
    },
    "sidebar": { "$value": "17rem" },
    "$description": "Fixed sizes that are not on the spacing scale: control heights (D-018), container widths, sidebar width."
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "0.375rem" },
    "md": { "$value": "0.75rem" },
    "lg": { "$value": "1.25rem" },
    "full": { "$value": "9999px" },
    "$description": "Corner radii. Soft."
  },
  "border-width": {
    "$type": "dimension",
    "1": { "$value": "1px" },
    "2": { "$value": "2px" },
    "$description": "Border thickness."
  },
  "ring": {
    "$type": "dimension",
    "width": { "$value": "2px" },
    "offset": { "$value": "2px" },
    "$description": "Raw focus ring metrics. Components use the semantic focus.ring-* tokens instead."
  }
}
