{
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": {
        "$value": "Fraunces, Georgia, serif",
        "$description": "Display and heading font (Fraunces, a soft serif) with a serif fallback stack."
      },
      "body": {
        "$value": "Nunito Sans, system-ui, sans-serif",
        "$description": "Body, label and control font (Nunito Sans) with system fallback stack."
      }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem", "$description": "12px" },
      "sm": { "$value": "0.875rem", "$description": "14px" },
      "base": { "$value": "1.0625rem", "$description": "17px" },
      "lg": { "$value": "1.25rem", "$description": "20px" },
      "xl": { "$value": "1.625rem", "$description": "26px" },
      "2xl": { "$value": "2.125rem", "$description": "34px" },
      "3xl": { "$value": "3.25rem", "$description": "52px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.25, "$description": "Unitless; headings." },
      "normal": { "$value": 1.6, "$description": "Unitless; body text." },
      "relaxed": { "$value": 1.8, "$description": "Unitless; lead text." }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": { "$value": "-0.01em" },
      "normal": { "$value": "0em" }
    }
  }
}
