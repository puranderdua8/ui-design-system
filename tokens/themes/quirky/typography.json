{
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": {
        "$value": "Bricolage Grotesque, system-ui, sans-serif",
        "$description": "Display and heading font (Bricolage Grotesque) with system fallback stack."
      },
      "body": {
        "$value": "Bricolage Grotesque, system-ui, sans-serif",
        "$description": "Body, label and control font (Bricolage Grotesque) with system fallback stack."
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        },
        "$description": "12px"
      },
      "sm": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        },
        "$description": "14px"
      },
      "base": {
        "$value": {
          "value": 1,
          "unit": "rem"
        },
        "$description": "16px"
      },
      "lg": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        },
        "$description": "20px"
      },
      "xl": {
        "$value": {
          "value": 1.625,
          "unit": "rem"
        },
        "$description": "26px"
      },
      "2xl": {
        "$value": {
          "value": 2.25,
          "unit": "rem"
        },
        "$description": "36px"
      },
      "3xl": {
        "$value": {
          "value": 3.5,
          "unit": "rem"
        },
        "$description": "56px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.1,
        "$description": "Unitless; headings."
      },
      "normal": {
        "$value": 1.5,
        "$description": "Unitless; body text."
      },
      "relaxed": {
        "$value": 1.7,
        "$description": "Unitless; lead text."
      }
    },
    "letter-spacing": {
      "$type": "number",
      "tight": {
        "$value": -0.03
      },
      "normal": {
        "$value": 0
      },
      "$description": "Unitless: a multiple of the font size. The build writes it as em, so it follows each element's own size."
    }
  }
}
