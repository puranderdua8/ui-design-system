{
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": {
        "$value": "IBM Plex Sans, system-ui, sans-serif",
        "$description": "Display and heading font (IBM Plex Sans) with system fallback stack."
      },
      "body": {
        "$value": "IBM Plex Sans, system-ui, sans-serif",
        "$description": "Body, label and control font (IBM Plex Sans) with system fallback stack."
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        },
        "$description": "12px"
      },
      "sm": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        },
        "$description": "14px"
      },
      "base": {
        "$value": {
          "value": 1,
          "unit": "rem"
        },
        "$description": "16px"
      },
      "lg": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        },
        "$description": "18px"
      },
      "xl": {
        "$value": {
          "value": 1.375,
          "unit": "rem"
        },
        "$description": "22px"
      },
      "2xl": {
        "$value": {
          "value": 1.75,
          "unit": "rem"
        },
        "$description": "28px"
      },
      "3xl": {
        "$value": {
          "value": 2.5,
          "unit": "rem"
        },
        "$description": "40px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2,
        "$description": "Unitless; headings."
      },
      "normal": {
        "$value": 1.45,
        "$description": "Unitless; body text."
      },
      "relaxed": {
        "$value": 1.6,
        "$description": "Unitless; lead text."
      }
    },
    "letter-spacing": {
      "$type": "number",
      "tight": {
        "$value": -0.01
      },
      "normal": {
        "$value": 0
      },
      "$description": "Unitless: a multiple of the font size. The build writes it as em, so it follows each element's own size."
    }
  }
}
