{
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": {
        "$value": "Inter, system-ui, sans-serif",
        "$description": "Display and heading font (Inter) with system fallback stack."
      },
      "body": {
        "$value": "Inter, system-ui, sans-serif",
        "$description": "Body, label and control font (Inter) with system fallback stack."
      }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem", "$description": "12px" },
      "sm": { "$value": "0.875rem", "$description": "14px" },
      "base": { "$value": "1rem", "$description": "16px" },
      "lg": { "$value": "1.25rem", "$description": "20px" },
      "xl": { "$value": "1.5rem", "$description": "24px" },
      "2xl": { "$value": "2rem", "$description": "32px" },
      "3xl": { "$value": "3rem", "$description": "48px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2, "$description": "Unitless; headings." },
      "normal": { "$value": 1.5, "$description": "Unitless; body text." },
      "relaxed": { "$value": 1.7, "$description": "Unitless; lead text." }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" },
      "normal": { "$value": "0em" }
    }
  }
}
