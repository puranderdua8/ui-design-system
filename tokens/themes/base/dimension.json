{
  "space": {
    "$type": "dimension",
    "$description": "Key is the multiple of 0.25rem; 1-5 means 1.5.",
    "1": {
      "$value": "0.25rem"
    },
    "1-5": {
      "$value": "0.375rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    },
    "24": {
      "$value": "6rem"
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "sm": {
        "$value": "2rem"
      },
      "md": {
        "$value": "2.5rem"
      }
    },
    "container": {
      "sm": {
        "$value": "40rem"
      },
      "md": {
        "$value": "48rem"
      },
      "lg": {
        "$value": "64rem"
      },
      "xl": {
        "$value": "80rem"
      }
    },
    "sidebar": {
      "$value": "16rem"
    },
    "$description": "Fixed sizes that are not on the spacing scale: control heights (D-018), container widths, sidebar width."
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "0.25rem"
    },
    "md": {
      "$value": "0.5rem"
    },
    "lg": {
      "$value": "0.75rem"
    },
    "full": {
      "$value": "9999px"
    },
    "$description": "Corner radii."
  },
  "border-width": {
    "$type": "dimension",
    "1": {
      "$value": "1px"
    },
    "2": {
      "$value": "2px"
    },
    "$description": "Border thickness."
  },
  "ring": {
    "$type": "dimension",
    "width": {
      "$value": "2px"
    },
    "offset": {
      "$value": "2px"
    },
    "$description": "Raw focus ring metrics. Components use the semantic focus.ring-* tokens instead."
  }
}
