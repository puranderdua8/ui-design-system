{
  "breakpoint": {
    "$type": "dimension",
    "$description": "Shared, never themed (media queries cannot read custom properties). Match Tailwind v4's defaults. Not emitted or bridged yet.",
    "sm": {
      "$value": {
        "value": 40,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 48,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 64,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 80,
        "unit": "rem"
      }
    },
    "2xl": {
      "$value": {
        "value": 96,
        "unit": "rem"
      }
    }
  }
}
