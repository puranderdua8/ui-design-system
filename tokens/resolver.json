{
  "name": "@puranderdua/ui tokens",
  "version": "2025.10",
  "description": "DTCG Resolver Module (2025.10) manifest. scripts/build-tokens.mjs resolves it: one output per theme, for each built mode. The mode modifier reserves dark; only light is built for now (D-047).",
  "sets": {
    "shared": {
      "description": "Non-themeable primitives. Breakpoints are validated only; layers are emitted once into foundations.css.",
      "sources": [
        { "$ref": "primitives/breakpoints.json" },
        { "$ref": "primitives/layers.json" }
      ]
    },
    "semantic": {
      "description": "Role contract. Aliases only; identical for every theme.",
      "sources": [
        { "$ref": "semantic/color.json" },
        { "$ref": "semantic/control.json" },
        { "$ref": "semantic/effects.json" },
        { "$ref": "semantic/layout.json" },
        { "$ref": "semantic/shape.json" },
        { "$ref": "semantic/tone.json" },
        { "$ref": "semantic/typography.json" }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "description": "Themeable primitives. Every theme defines exactly Base's keys (D-048).",
      "default": "base",
      "contexts": {
        "base": [
          { "$ref": "themes/base/color.json" },
          { "$ref": "themes/base/dimension.json" },
          { "$ref": "themes/base/effects.json" },
          { "$ref": "themes/base/typography.json" }
        ],
        "corporate": [
          { "$ref": "themes/corporate/color.json" },
          { "$ref": "themes/corporate/dimension.json" },
          { "$ref": "themes/corporate/effects.json" },
          { "$ref": "themes/corporate/typography.json" }
        ],
        "nature": [
          { "$ref": "themes/nature/color.json" },
          { "$ref": "themes/nature/dimension.json" },
          { "$ref": "themes/nature/effects.json" },
          { "$ref": "themes/nature/typography.json" }
        ],
        "quirky": [
          { "$ref": "themes/quirky/color.json" },
          { "$ref": "themes/quirky/dimension.json" },
          { "$ref": "themes/quirky/effects.json" },
          { "$ref": "themes/quirky/typography.json" }
        ]
      }
    },
    "mode": {
      "description": "Light only for now; dark is reserved and has no sources yet.",
      "default": "light",
      "contexts": {
        "light": [],
        "dark": []
      }
    }
  },
  "resolutionOrder": [
    { "$ref": "#/sets/shared" },
    { "$ref": "#/modifiers/theme" },
    { "$ref": "#/sets/semantic" },
    { "$ref": "#/modifiers/mode" }
  ]
}
